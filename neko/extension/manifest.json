{
  "manifest_version": 3,
  "name": "StreamDeck helper",
  "version": "0.2.0",
  "description": "Hides streaming-site chrome (cosmetic CSS) and navigates the browser to the title StreamDeck asks to play.",
  "permissions": ["tabs", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "css": ["netflix.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.disneyplus.com/*"],
      "css": ["disneyplus.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.hulu.com/*"],
      "css": ["hulu.css"],
      "run_at": "document_idle"
    }
  ]
}
