# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Postgres ---
POSTGRES_USER=streamdeck
POSTGRES_PASSWORD=change-me
POSTGRES_DB=streamdeck

# --- TMDB (free key: https://www.themoviedb.org/settings/api) ---
TMDB_API_KEY=

# --- neko (streamed browser) ---
# URL your *browser* uses to reach neko (LAN IP if viewing from another device)
NEKO_PUBLIC_URL=http://localhost:8080
NEKO_USER_PASSWORD=neko
NEKO_ADMIN_PASSWORD=admin-change-me
# Optional: enables auto-navigation on Play. Requires the chromium.conf override
# (see neko/README.md). Leave empty to disable.
NEKO_CDP_URL=

# --- Streaming service credentials (owner's own accounts only) ---
# Shown in the player page behind a "show credentials" click to ease the
# one-time manual sign-in. Pattern: SVC_<SLUG>_USERNAME / SVC_<SLUG>_PASSWORD
SVC_NETFLIX_USERNAME=
SVC_NETFLIX_PASSWORD=
SVC_DISNEYPLUS_USERNAME=
SVC_DISNEYPLUS_PASSWORD=
SVC_HULU_USERNAME=
SVC_HULU_PASSWORD=
SVC_PRIMEVIDEO_USERNAME=
SVC_PRIMEVIDEO_PASSWORD=
SVC_MAX_USERNAME=
SVC_MAX_PASSWORD=
