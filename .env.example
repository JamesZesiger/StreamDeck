# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Postgres ---
POSTGRES_USER=streamdeck
POSTGRES_PASSWORD=change-me
POSTGRES_DB=streamdeck

# --- TMDB (free key: https://www.themoviedb.org/settings/api) ---
TMDB_API_KEY=

# --- homenet dashBoard (optional) ---
# Set to dashBoard's port to show a Dashboard button in the nav; leave unset
# when running streamDeck on its own.
# DASHBOARD_PORT=8080

