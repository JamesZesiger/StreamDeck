# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Postgres ---
POSTGRES_USER=streamdeck
POSTGRES_PASSWORD=change-me
POSTGRES_DB=streamdeck

# --- TMDB (free key: https://www.themoviedb.org/settings/api) ---
TMDB_API_KEY=

# --- Streaming service credentials (owner's own accounts only) ---
# LEGACY FALLBACK — the preferred place for site credentials is config/sites.json
# (managed from the Sites page in the UI, created on first startup).
# These env vars are only used when the JSON entry has no credentials.
# Pattern: SVC_<SLUG>_USERNAME / SVC_<SLUG>_PASSWORD
SVC_NETFLIX_USERNAME=
SVC_NETFLIX_PASSWORD=
SVC_DISNEYPLUS_USERNAME=
SVC_DISNEYPLUS_PASSWORD=
SVC_HULU_USERNAME=
SVC_HULU_PASSWORD=
SVC_PRIMEVIDEO_USERNAME=
SVC_PRIMEVIDEO_PASSWORD=
SVC_MAX_USERNAME=
SVC_MAX_PASSWORD=
